# Copia questo file in .env e riempi i valori.
# .env non entra MAI nel repository.
#
# Regola: ogni variabile nuova va aggiunta qui, con valore fittizio e una
# riga di commento, nello stesso commit che la introduce.

# --- Ambiente ---
ENV=development
LOG_LEVEL=info

# --- Route engine ---
# Cartella dove tenere i grafi stradali scaricati (esclusa da git)
OSM_CACHE_DIR=./data/cache

