{
  "expo": {
    "name": "ShapeRoute",
    "slug": "shaperoute",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sgrava uses the picture you choose to trace the outline your route will draw.",
          "cameraPermission": "Sgrava uses the photo you take to trace the outline your route will draw.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
