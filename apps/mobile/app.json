{
  "expo": {
    "name": "MuW",
    "slug": "shaperoute",
    "version": "1.0.0",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/47bc672d-5824-4e77-84c4-b44132c6e87f"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lppl1316.sgrava",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "it": "./locales/it.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json"
    },
